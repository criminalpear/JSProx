{
  "name": "JSProx",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Install the Ultraviolet stack once when the Codespace is created.
  "postCreateCommand": "cd ultraviolet && npm install",

  // Start the proxy automatically each time you attach. Runs detached; logs to /tmp/uv.log.
  "postAttachCommand": "cd ultraviolet && (nohup npm start > /tmp/uv.log 2>&1 &) && echo 'JSProx starting on port 8080 — open the forwarded 8080 URL.'",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "JSProx",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
